+template <int ncols_dst, int rows_per_warp>
+static void launch_mul_mat_vec_fp8_rows(
+        const ggml_fp8_e4m3_t * x, const float * y, float * dst, const int64_t ncols, const int64_t nrows,
+        const int64_t stride_row, const int64_t stride_col_y, const int64_t stride_col_dst,
+        const int64_t nchannels_x, const int64_t nchannels_dst, const int64_t stride_channel_x, const int64_t stride_channel_y, const int64_t stride_channel_dst,
+        const int64_t nsamples_x, const int64_t nsamples_dst, const int64_t stride_sample_x, const int64_t stride_sample_y, const int64_t stride_sample_dst,
+        cudaStream_t stream) {
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    constexpr int nwarps = 4;
+    const int64_t rows_per_block = nwarps*rows_per_warp;
+    const dim3 block_nums((nrows + rows_per_block - 1)/rows_per_block, nchannels_dst, nsamples_dst);
+    const dim3 block_dims(nwarps*warp_size, 1, 1);
+    mul_mat_vec_fp8_rows<ncols_dst, rows_per_warp><<<block_nums, block_dims, 0, stream>>>(
+        x, y, dst, ncols, nrows, stride_row, stride_col_y, stride_col_dst,
+        nchannels_dst/nchannels_x, stride_channel_x, stride_channel_y, stride_channel_dst,
+        nsamples_dst/nsamples_x, stride_sample_x, stride_sample_y, stride_sample_dst);
+}
+
+// Returns false if the shape or alignment does not fit; the caller then uses mul_mat_vec_f.
+static bool mul_mat_vec_fp8_rows_cuda(
+        const ggml_fp8_e4m3_t * x, const float * y, float * dst, const int64_t ncols, const int64_t nrows, const int64_t ncols_dst,
+        const int64_t stride_row, const int64_t stride_col_y, const int64_t stride_col_dst,
+        const int64_t nchannels_x, const int64_t nchannels_dst, const int64_t stride_channel_x, const int64_t stride_channel_y, const int64_t stride_channel_dst,
+        const int64_t nsamples_x, const int64_t nsamples_dst, const int64_t stride_sample_x, const int64_t stride_sample_y, const int64_t stride_sample_dst,
+        cudaStream_t stream) {
+    const bool aligned = ncols % 16 == 0 && stride_row % 16 == 0 && stride_channel_x % 16 == 0 && stride_sample_x % 16 == 0 &&
+        stride_col_y % 4 == 0 && stride_channel_y % 4 == 0 && stride_sample_y % 4 == 0 &&
+        (uintptr_t) x % 16 == 0 && (uintptr_t) y % 16 == 0;
+    if (ncols_dst < 2 || ncols_dst > 8 || !aligned || nchannels_dst % nchannels_x != 0 || nsamples_dst % nsamples_x != 0) {
+        return false;
+    }
+#define LAUNCH_FP8_ROWS(ncd, rpw) launch_mul_mat_vec_fp8_rows<ncd, rpw>(x, y, dst, ncols, nrows, stride_row, stride_col_y, stride_col_dst, \
+        nchannels_x, nchannels_dst, stride_channel_x, stride_channel_y, stride_channel_dst, nsamples_x, nsamples_dst, stride_sample_x, stride_sample_y, stride_sample_dst, stream)
+    switch (ncols_dst) {
+        case 2: LAUNCH_FP8_ROWS(2, 2); break;
+        case 3: LAUNCH_FP8_ROWS(3, 2); break;
+        case 4: LAUNCH_FP8_ROWS(4, 4); break;
+        case 5: LAUNCH_FP8_ROWS(5, 4); break;
+        case 6: LAUNCH_FP8_ROWS(6, 4); break;
+        case 7: LAUNCH_FP8_ROWS(7, 2); break;
+        case 8: LAUNCH_FP8_ROWS(8, 2); break;
+    }
+#undef LAUNCH_FP8_ROWS
+    return true;
+}
