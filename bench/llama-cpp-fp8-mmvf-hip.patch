index 5fdec4220..c78bbb5ad 100644
--- a/ggml/src/ggml-cuda/fp8.cu
+++ b/ggml/src/ggml-cuda/fp8.cu
@@ -204,3 +204,209 @@ bool ggml_cuda_mul_mat_fp8(
