+// E4M3 -> F16 with the per-tensor weight scale applied, so F16 GEMM does not overflow on unscaled values up to 448.
+static __global__ void convert_fp8_scaled_f16(const uint32_t * __restrict__ x, half * __restrict__ y, const float * __restrict__ scale, const int64_t n4) {
+    const int64_t i = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n4) {
+        return;
+    }
+    const uint32_t w = x[i];
+    const float s = 256.0f * *scale;
+    const uint32_t even = ((w << 8) & 0x80008000u) | ((w << 7) & 0x3F803F80u);
+    const uint32_t odd  = (w & 0x80008000u) | ((w >> 1) & 0x3F803F80u);
+    const uint16_t h[4] = {(uint16_t) even, (uint16_t) odd, (uint16_t) (even >> 16), (uint16_t) (odd >> 16)};
+    uint16_t out[4];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const bool is_nan = ((w >> (8*k)) & 0x7F) == 0x7F;
+        out[k] = __half_as_ushort(is_nan ? __float2half(NAN) : __float2half(__half2float(__ushort_as_half(h[k])) * s));
+    }
+    ((uint2 *) y)[i] = make_uint2(out[0] | ((uint32_t) out[1] << 16), out[2] | ((uint32_t) out[3] << 16));
+}
+
+// MUL_MAT of F8 weights fused with the MUL by their per-tensor scale, for more than MMVF_MAX_BATCH_SIZE columns.
+// Folds the scale into an F16 copy of the weights and runs the regular F16 cuBLAS path, writing to the MUL output.
+static bool ggml_cuda_mul_mat_fp8_scaled_f16(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst, const ggml_tensor * scale) {
+    if (src0->type != GGML_TYPE_F8_E4M3 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || !scale ||
+            src1->ne[1] <= MMVF_MAX_BATCH_SIZE || !ggml_is_contiguous(src0) || !ggml_is_contiguous(dst) || src0->ne[0] % 16 != 0 ||
+            !ggml_cuda_is_aligned(src0, 4) || !fast_fp16_hardware_available(ggml_cuda_info().devices[ctx.device].cc)) {
+        return false;
+    }
+    if (ggml_cuda_mul_mat_fp8_wmma(ctx, src0, src1, dst, scale)) {
+        return true;
+    }
+    const int64_t ne = ggml_nelements(src0);
+    ggml_cuda_pool_alloc<half> src0_f16(ctx.pool(), ne);
+    const int64_t n4 = ne/4;
+    convert_fp8_scaled_f16<<<(n4 + 255)/256, 256, 0, ctx.stream()>>>(
+        (const uint32_t *) src0->data, src0_f16.ptr, (const float *) scale->data, n4);
+    CUDA_CHECK(cudaGetLastError());
+
+    ggml_tensor src0_view = *src0;
+    src0_view.type  = GGML_TYPE_F16;
+    src0_view.data  = src0_f16.ptr;
+    src0_view.nb[0] = sizeof(half);
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        src0_view.nb[i] = src0_view.nb[i - 1]*src0_view.ne[i - 1];
+    }
+    ggml_cuda_mul_mat_cublas(ctx, &src0_view, src1, dst);
+    return true;
+}
