+// FP8 rows for 2..8 columns: each warp does rows_per_warp rows, so one activation load serves several rows.
+// ksplit warps share the same rows and split the row length, so small matrices still fill the GPU.
+template <int ncols_dst, int rows_per_warp, int ksplit>
+static __global__ void mul_mat_vec_fp8_rows(
+        const ggml_fp8_e4m3_t * __restrict__ x, const float * __restrict__ y, float * __restrict__ dst, const int ncols, const int nrows,
+        const int64_t stride_row, const int64_t stride_col_y, const int64_t stride_col_dst,
+        const int channel_ratio, const int64_t stride_channel_x, const int64_t stride_channel_y, const int64_t stride_channel_dst,
+        const int sample_ratio, const int64_t stride_sample_x, const int64_t stride_sample_y, const int64_t stride_sample_dst) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = 4;
+    const int lane  = threadIdx.x % warp_size;
+    const int warp  = threadIdx.x / warp_size;
+    const int kpart = warp % ksplit;
+    const int row0  = (blockIdx.x*(nwarps/ksplit) + warp/ksplit) * rows_per_warp;
+    const int channel_dst = blockIdx.y;
+    const int sample_dst  = blockIdx.z;
+    x   += int64_t(sample_dst/sample_ratio)*stride_sample_x + int64_t(channel_dst/channel_ratio)*stride_channel_x;
+    y   += int64_t(sample_dst)*stride_sample_y + int64_t(channel_dst)*stride_channel_y;
+    dst += int64_t(sample_dst)*stride_sample_dst + int64_t(channel_dst)*stride_channel_dst;
+
+    float sumf[ncols_dst][rows_per_warp] = {{0.0f}};
+    uint32_t nan_bytes[rows_per_warp] = {0};
+    for (int c = kpart*warp_size + lane; c < ncols/16; c += ksplit*warp_size) {
+        uint4 tmpx[rows_per_warp];
+#pragma unroll
+        for (int r = 0; r < rows_per_warp; ++r) {
+            // weights are read once: keep them out of the cache so the activations stay in it
+            typedef uint32_t uint32x4_t __attribute__((ext_vector_type(4)));
+            const uint32x4_t v = __builtin_nontemporal_load((const uint32x4_t *) (x + min(row0 + r, nrows - 1)*stride_row) + c);
+            tmpx[r] = make_uint4(v.x, v.y, v.z, v.w);
+        }
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            const float4 * y4 = (const float4 *) (y + j*stride_col_y) + 4*c;
+            const float4 tmpy[4] = {y4[0], y4[1], y4[2], y4[3]};
+#pragma unroll
+            for (int r = 0; r < rows_per_warp; ++r) {
+                nan_bytes[r] |= mmvf_fma_fp8x16(sumf[j][r], tmpx[r], tmpy);
+            }
+        }
+    }
+
+    __shared__ float partial[nwarps][ncols_dst*rows_per_warp];
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int r = 0; r < rows_per_warp; ++r) {
+            const float sum = warp_reduce_sum<warp_size>(nan_bytes[r] ? NAN : 256.0f*sumf[j][r]);
+            if constexpr (ksplit == 1) {
+                if (lane == 0 && row0 + r < nrows) {
