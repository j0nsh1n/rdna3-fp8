+static spv::Id emit_coopmat_round_fp8(Converter::Impl &impl, spv::Id v, spv::Id type_id, bool f16)
+{
+	spv::Id call_id = impl.spirv_module.get_helper_call_id(
+	    f16 ? HelperCall::CoopMatRoundFP8F16 : HelperCall::CoopMatRoundFP8F32, type_id);
+
+	// RADV workaround. Should pass as value, but NIR aborts.
+	spv::Id param = impl.create_variable(spv::StorageClassFunction, type_id);
+	auto *store = impl.allocate(spv::OpStore);
+	store->add_id(param);
+	store->add_id(v);
+	impl.add(store);
+
+	auto *call = impl.allocate(spv::OpFunctionCall, type_id);
+	call->add_id(call_id);
+	call->add_id(param);
+	impl.add(call);
+
+	return call->id;
+}
