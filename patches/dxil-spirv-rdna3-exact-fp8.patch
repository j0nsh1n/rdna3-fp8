+// Rounds every element to the nearest E4M3 value in F32 (ties to even, saturating at +-448, NaN kept), so the result is
+// exact in F16. Matches RDNA4's saturating F32 -> FP8 conversion. With C = 1.5 * 2^(E + 20) for the exponent E of
+// clamp(|x|, 2^-6, 448), (|x| + C) - C rounds |x| to a multiple of 2^(E - 3); 2^-6 as the floor gives the subnormal step.
+spv::Id SPIRVModule::Impl::build_coop_mat_round_fp8(SPIRVModule &module, spv::Id type_id, bool f16)
+{
+	HelperCall helper = f16 ? HelperCall::CoopMatRoundFP8F16 : HelperCall::CoopMatRoundFP8F32;
+	for (auto &ops : coop_mat_conv_ids)
+		if (ops.output_type == type_id && ops.input_type == type_id && ops.call == helper)
+			return ops.func_id;
+
+	auto *current_build_point = builder.getBuildPoint();
+
+	spv::Block *entry = nullptr;
+	spv::Id uint_type = builder.makeUintType(32);
+	spv::Id bool_type = builder.makeBoolType();
+	spv::Id f32_type = builder.makeFloatType(32);
+	spv::Id elem_type = f16 ? builder.makeFloatType(16) : f32_type;
+
+	// RADV workaround. It fails to understand coopmat passed as value.
+	spv::Id ptr_type = builder.makePointer(spv::StorageClassFunction, type_id);
+
+	auto *func = builder.makeFunctionEntry(spv::NoPrecision, type_id,
+	                                       f16 ? "CoopMatRoundFP8F16" : "CoopMatRoundFP8F32",
+	                                       { ptr_type }, {}, &entry);
+
+	spv::Id output_id = create_variable(spv::StorageClassFunction, type_id, "coop_output");
+	auto *len = builder.addInstruction(uint_type, spv::OpCooperativeMatrixLengthKHR);
+	len->addIdOperand(type_id);
+
+	auto *header = func->newBlock(builder.getUniqueId());
+	auto *merge = func->newBlock(builder.getUniqueId());
+	builder.createBranch(header);
+	builder.setBuildPoint(header);
+	{
+		auto *phi = builder.addInstruction(uint_type, spv::OpPhi);
+		auto *iter = builder.addInstruction(uint_type, spv::OpIAdd);
+		iter->addIdOperand(phi->getResultId());
+		iter->addIdOperand(builder.makeUintConstant(1));
+
+		phi->addIdOperand(builder.makeUintConstant(0));
+		phi->addIdOperand(entry->getId());
+		phi->addIdOperand(iter->getResultId());
+		phi->addIdOperand(header->getId());
+
+		auto *input_chain = builder.addInstruction(
+		    builder.makePointer(spv::StorageClassFunction, elem_type), spv::OpInBoundsAccessChain);
+		input_chain->addIdOperand(func->getParamId(0));
+		input_chain->addIdOperand(phi->getResultId());
+
+		auto *load = builder.addInstruction(elem_type, spv::OpLoad);
+		load->addIdOperand(input_chain->getResultId());
+		spv::Id x = load->getResultId();
+
+		if (f16)
+		{
+			auto *widen = builder.addInstruction(f32_type, spv::OpFConvert);
+			widen->addIdOperand(x);
+			x = widen->getResultId();
+		}
+
+		spv::Id glsl450 = builder.import("GLSL.std.450");
+		const auto op1 = [&](spv::Id type, spv::Op op, spv::Id a) {
+			auto *i = builder.addInstruction(type, op);
+			i->addIdOperand(a);
+			return i->getResultId();
+		};
+		const auto op2 = [&](spv::Id type, spv::Op op, spv::Id a, spv::Id b) {
+			auto *i = builder.addInstruction(type, op);
+			i->addIdOperand(a);
+			i->addIdOperand(b);
+			return i->getResultId();
+		};
+		const auto nclamp = [&](spv::Id a, float lo, float hi) {
+			auto *i = builder.addInstruction(f32_type, spv::OpExtInst);
+			i->addIdOperand(glsl450);
+			i->addImmediateOperand(GLSLstd450NClamp);
+			i->addIdOperand(a);
+			i->addIdOperand(builder.makeFloatConstant(lo));
+			i->addIdOperand(builder.makeFloatConstant(hi));
+			return i->getResultId();
+		};
+
+		spv::Id bits = op1(uint_type, spv::OpBitcast, x);
+		auto *abs = builder.addInstruction(f32_type, spv::OpExtInst);
+		abs->addIdOperand(glsl450);
+		abs->addImmediateOperand(GLSLstd450FAbs);
+		abs->addIdOperand(x);
+		spv::Id ax = abs->getResultId();
+
+		spv::Id cb = op2(uint_type, spv::OpBitwiseAnd, op1(uint_type, spv::OpBitcast, nclamp(ax, 0.015625f, 448.0f)),
+		                 builder.makeUintConstant(0x7f800000u));
+		cb = op2(uint_type, spv::OpIAdd, cb, builder.makeUintConstant(0x0a400000u));
+		spv::Id c = op1(f32_type, spv::OpBitcast, cb);
+
+		// Must stay two rounded operations; NoContraction keeps the compiler from folding them away.
+		spv::Id sum = op2(f32_type, spv::OpFAdd, ax, c);
+		builder.addDecoration(sum, spv::DecorationNoContraction);
+		spv::Id r = op2(f32_type, spv::OpFSub, sum, c);
+		builder.addDecoration(r, spv::DecorationNoContraction);
+		r = nclamp(r, 0.0f, 448.0f);
+
+		spv::Id rb = op1(uint_type, spv::OpBitcast, r);
+		spv::Id is_nan = op1(bool_type, spv::OpIsNan, x);
+		auto *sel = builder.addInstruction(uint_type, spv::OpSelect);
+		sel->addIdOperand(is_nan);
+		sel->addIdOperand(builder.makeUintConstant(0x7fc00000u));
+		sel->addIdOperand(rb);
+		rb = op2(uint_type, spv::OpBitwiseOr, sel->getResultId(),
+		         op2(uint_type, spv::OpBitwiseAnd, bits, builder.makeUintConstant(0x80000000u)));
+		spv::Id y = op1(f32_type, spv::OpBitcast, rb);
+		if (f16)
+			y = op1(elem_type, spv::OpFConvert, y);
+
+		auto *output_chain = builder.addInstruction(
+		    builder.makePointer(spv::StorageClassFunction, elem_type), spv::OpInBoundsAccessChain);
+		output_chain->addIdOperand(output_id);
+		output_chain->addIdOperand(phi->getResultId());
+		auto *store = builder.addInstruction(spv::OpStore);
+		store->addIdOperand(output_chain->getResultId());
+		store->addIdOperand(y);
+
+		auto *cmp = builder.addInstruction(bool_type, spv::OpULessThan);
+		cmp->addIdOperand(iter->getResultId());
+		cmp->addIdOperand(len->getResultId());
+		builder.createLoopMerge(merge, header, 0);
+		builder.createConditionalBranch(cmp->getResultId(), header, merge);
+	}
+
+	builder.setBuildPoint(merge);
+	auto *loaded_result = builder.addInstruction(type_id, spv::OpLoad);
+	loaded_result->addIdOperand(output_id);
+	builder.makeReturnValue(loaded_result->getResultId());
+	builder.setBuildPoint(current_build_point);
+	coop_mat_conv_ids.push_back({ type_id, type_id, func->getId(), helper });
+	return func->getId();
+}
